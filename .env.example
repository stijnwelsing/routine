# Copy to app/.env.local (Vite loads env from the app folder).
# Do not commit real keys.
# Do not register DNS or deploy. Preview is local / app/dist only.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Intended product origin for later magic-link (Auth → URL configuration).
# Product: https://aretan.app
# Reserve: aretan.nl, aretan.eu
# Local now: http://localhost:5173
# VITE_SITE_URL=https://aretan.app
